#cloud-config
# 占位符由 vm/entrypoint.sh 生成 seed 时替换。
hostname: ce-vm
preserve_hostname: false

users:
  - name: ce
    uid: 10001
    shell: /bin/bash
    lock_passwd: true
__SSH_AUTHORIZED_KEYS__

write_files:
  - path: /etc/sudoers.d/ce-restart
    permissions: "0440"
    content: |
      ce ALL=(root) NOPASSWD: /usr/bin/systemctl restart ce.service, /usr/bin/systemctl status ce.service, /usr/bin/systemctl is-active ce.service

runcmd:
  - mkdir -p /opt/compiler-explorer /mnt/ce-repo
  - printf 'compilers /opt/compiler-explorer 9p trans=virtio,version=9p2000.L,ro,_netdev,nofail 0 0\n' >> /etc/fstab
  - printf 'cerepo /mnt/ce-repo 9p trans=virtio,version=9p2000.L,ro,_netdev,nofail 0 0\n' >> /etc/fstab
  - systemctl daemon-reload
  - mount -a

  - NODE_VERSION="__NODE_VERSION__" NODE_SHA256="__NODE_SHA256__" bash /mnt/ce-repo/vm/provision-ce.sh "__CE_REF__"
