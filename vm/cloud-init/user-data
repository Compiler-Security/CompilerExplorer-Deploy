#cloud-config
# CompilerExplorer VM 首启装配（cloud-init，仅实例首次启动执行一次）。
# CE 直接跑在 VM 上（node + systemd + nsjail），无内层 docker。
# 依赖 QEMU 9p 共享：
#   mount_tag=compilers -> 宿主机工具链根（只读，挂到 /opt/compiler-explorer）
#   mount_tag=cerepo    -> 本仓库（只读，挂到 /mnt/ce-repo，取 config/ scripts/ vm/）
# __CE_REF__ / __SSH_PUBKEY__ 由 vm/entrypoint.sh 在生成 seed 时注入。
hostname: ce-vm
preserve_hostname: false

package_update: true
packages:
  - curl
  - ca-certificates
  - openssh-server

# ce 用户（uid 10001）：CE 进程与 nsjail 用；宿主机经 SSH 进来重启 CE 以清缓存。
users:
  - name: ce
    uid: 10001
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - __SSH_PUBKEY__

# 最小权限 sudo：只允许 ce 重启/查看 ce.service（供宿主机在工具链更新后清 CE 缓存）。
write_files:
  - path: /etc/sudoers.d/ce-restart
    permissions: "0440"
    content: |
      ce ALL=(root) NOPASSWD: /bin/systemctl restart ce.service, /bin/systemctl status ce.service, /bin/systemctl is-active ce.service

runcmd:
  # 1) 9p 共享写入 /etc/fstab 持久化（重启不丢），并立即挂载
  - mkdir -p /opt/compiler-explorer /mnt/ce-repo
  - printf 'compilers /opt/compiler-explorer 9p trans=virtio,version=9p2000.L,ro,_netdev,nofail 0 0\n' >> /etc/fstab
  - printf 'cerepo /mnt/ce-repo 9p trans=virtio,version=9p2000.L,ro,_netdev,nofail 0 0\n' >> /etc/fstab
  - systemctl daemon-reload
  - mount -a

  # 2) 装配 CE（装 node+nsjail、克隆并构建 CE@__CE_REF__、软链配置、nsjail cgroup 前置、起 systemd 服务）
  - bash /mnt/ce-repo/vm/provision-ce.sh "__CE_REF__"
