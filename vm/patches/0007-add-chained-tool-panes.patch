+import {describe, expect, it} from 'vitest';
+
+import {BaseCompiler} from '../lib/base-compiler.js';
+import {parseTools} from '../lib/compilation/compilation-request-parser.js';
+import {OptionsHandlerLibrary} from '../lib/options-handler.js';
+import {ChainedToolResult, IChainedTool, ToolEnv} from '../lib/tooling/base-tool.interface.js';
+import {BaseTool} from '../lib/tooling/base-tool.js';
+import {ActiveTool, CompilationInfo} from '../types/compilation/compilation.interfaces.js';
+import {ToolInfo, ToolResult} from '../types/tool.interfaces.js';
+
+const env = {
+    ceProps: (_key: string, defaultValue: unknown) => defaultValue,
+    compilerProps: (_key: string, defaultValue: unknown) => defaultValue,
+} as ToolEnv;
+
+class FakeChainedTool extends BaseTool implements IChainedTool {
+    calls: Array<{input: string; args: string[]}> = [];
+    shouldFail = false;
+
+    async runChainedTool(
+        _compilationInfo: CompilationInfo,
+        inputFilepath: string,
+        args: string[] = [],
+        _stdin?: string,
+        _supportedLibraries?: Record<string, OptionsHandlerLibrary>,
+    ): Promise<ChainedToolResult> {
+        this.calls.push({input: inputFilepath, args});
+        const result: ToolResult = {
+            id: this.id,
+            name: this.tool.name,
+            code: this.shouldFail ? 1 : 0,
+            languageId: this.tool.languageId,
+            stdout: [],
+            stderr: [],
+        };
+        return {
+            result,
+            outputFilename: this.shouldFail ? undefined : inputFilepath + '.' + this.id,
+        };
+    }
+}
+
+function makeTool(id: string, nextTools: string[] = []) {
+    return new FakeChainedTool(
+        {
+            id,
+            name: id,
+            type: 'postcompilation',
+            exe: '/bin/true',
+            exclude: [],
+            options: [],
+            nextTools,
+            compilerLanguage: 'p4',
+        } as ToolInfo,
+        env,
+    );
+}
+
+function makeCompiler(tools: FakeChainedTool[]) {
+    const compiler = Object.create(BaseCompiler.prototype) as BaseCompiler & {
+        possibleTools: FakeChainedTool[];
+        supportedLibraries: Record<string, OptionsHandlerLibrary>;
+    };
+    compiler.possibleTools = tools;
+    compiler.supportedLibraries = {};
+    return compiler;
+}
+
+const compilationInfo = {
+    code: 0,
+    inputFilename: '/tmp/example.p4',
+    outputFilename: '/tmp/output.mlir',
+} as CompilationInfo;
+
+describe('chained post-compilation tools', () => {
+    it('preserves parentToolId while normalizing request arguments', () => {
+        expect(parseTools([{id: 'child', args: '--pass one', stdin: '', parentToolId: 'root'}] as any)).toEqual([
+            {id: 'child', args: ['--pass', 'one'], stdin: '', parentToolId: 'root'},
+        ]);
+    });
+
+    it('passes each parent output to its child and preserves stage arguments', async () => {
+        const root = makeTool('root', ['child']);
+        const child = makeTool('child');
+        const compiler = makeCompiler([root, child]);
+        const active: ActiveTool[] = [
+            {id: 'root', args: ['--root-pass'], stdin: ''},
+            {id: 'child', args: ['--child-pass'], stdin: '', parentToolId: 'root'},
+        ];
+
+        const results = await compiler.runPostCompilationTools(active, compilationInfo);
+
+        expect(results.map(result => result.code)).toEqual([0, 0]);
+        expect(root.calls).toEqual([{input: '/tmp/output.mlir', args: ['--root-pass']}]);
+        expect(child.calls).toEqual([{input: '/tmp/output.mlir.root', args: ['--child-pass']}]);
+    });
+
+    it('does not run a child when its parent fails', async () => {
+        const root = makeTool('root', ['child']);
+        root.shouldFail = true;
+        const child = makeTool('child');
+        const compiler = makeCompiler([root, child]);
+
+        const results = await compiler.runPostCompilationTools(
+            [
+                {id: 'root', args: [], stdin: ''},
+                {id: 'child', args: [], stdin: '', parentToolId: 'root'},
+            ],
+            compilationInfo,
+        );
+
+        expect(results[0].code).toBe(1);
+        expect(results[1]).toMatchObject({code: 1, stdout: [], stderr: []});
+        expect(child.calls).toHaveLength(0);
+    });
+
+    it('rejects missing parents and undeclared child relationships', async () => {
+        const root = makeTool('root');
+        const child = makeTool('child');
+        const compiler = makeCompiler([root, child]);
+
+        const missing = await compiler.runPostCompilationTools(
+            [{id: 'child', args: [], stdin: '', parentToolId: 'missing'}],
+            compilationInfo,
+        );
+        const undeclared = await compiler.runPostCompilationTools(
+            [
+                {id: 'root', args: [], stdin: ''},
+                {id: 'child', args: [], stdin: '', parentToolId: 'root'},
+            ],
+            compilationInfo,
+        );
+
+        expect(missing[0].stderr[0].text).toContain('Parent tool is not active');
+        expect(undeclared[1].stderr[0].text).toContain('not an allowed child');
+        expect(child.calls).toHaveLength(0);
+    });
+
+    it('rejects child tools submitted without their configured parent', async () => {
+        const root = makeTool('root', ['child']);
+        const child = makeTool('child');
+        const compiler = makeCompiler([root, child]);
+
+        const results = await compiler.runPostCompilationTools([{id: 'child', args: [], stdin: ''}], compilationInfo);
+
+        expect(results[0].stderr[0].text).toContain('requires an active parent');
+        expect(child.calls).toHaveLength(0);
+    });
+
+    it('rejects dependency cycles', async () => {
+        const first = makeTool('first', ['second']);
+        const second = makeTool('second', ['first']);
+        const compiler = makeCompiler([first, second]);
+
+        const results = await compiler.runPostCompilationTools(
+            [
+                {id: 'first', args: [], stdin: '', parentToolId: 'second'},
+                {id: 'second', args: [], stdin: '', parentToolId: 'first'},
+            ],
+            compilationInfo,
+        );
+
+        expect(results.every(result => result.code !== 0)).toBe(true);
+        expect(first.calls).toHaveLength(0);
+        expect(second.calls).toHaveLength(0);
+    });
+});
