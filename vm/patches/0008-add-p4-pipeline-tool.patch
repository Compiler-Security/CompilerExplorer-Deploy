+// CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+// SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+// INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+// CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+// ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+// POSSIBILITY OF SUCH DAMAGE.
+
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+
+import {afterEach, beforeEach, describe, expect, it} from 'vitest';
+
+import {ToolEnv} from '../lib/tooling/base-tool.interface.js';
+import {P4PipelineTool} from '../lib/tooling/p4-pipeline-tool.js';
+import {CompilationInfo, ExecutionOptions} from '../types/compilation/compilation.interfaces.js';
+import {UnprocessedExecResult} from '../types/execution/execution.interfaces.js';
+import {ToolInfo} from '../types/tool.interfaces.js';
+
+class TestP4PipelineTool extends P4PipelineTool {
+    calls: Array<{exe: string; args: string[]; options: ExecutionOptions}> = [];
+    code = 0;
+    output = 'generated output';
+    produceOutput = true;
+
+    override async exec(exe: string, args: string[], options: ExecutionOptions): Promise<UnprocessedExecResult> {
+        this.calls.push({exe, args, options});
+        const outputIndex = args.indexOf('-o');
+        if (this.code === 0 && this.produceOutput && outputIndex >= 0) {
+            await fs.writeFile(args[outputIndex + 1], this.output);
+        }
+        return {
+            code: this.code,
+            okToCache: true,
+            filenameTransform: filename => filename,
+            stdout: this.code === 0 ? '' : 'tool stdout',
+            stderr: this.code === 0 ? '' : 'tool stderr',
+            execTime: 1,
+            timedOut: false,
+            truncated: false,
+        };
+    }
+}
+
+let tempDir: string;
+let maxOutputSize = 1024;
+
+const env = {
+    ceProps: (key: string, defaultValue: unknown) => (key === 'max-asm-size' ? maxOutputSize : defaultValue),
+    compilerProps: (_key: string, defaultValue: unknown) => defaultValue,
+} as ToolEnv;
+
+const compilationInfo = {
+    compiler: {lang: 'p4'},
+    execOptions: {env: {PIPELINE_TEST: '1'}},
+    preparedLdPaths: ['/toolchain/lib'],
+} as unknown as CompilationInfo;
+
+function makeTool(id: string, options: string[] = []) {
+    return new TestP4PipelineTool(
+        {
+            id,
+            name: id,
+            type: 'postcompilation',
+            exe: `/toolchain/bin/${id}`,
+            exclude: [],
+            options,
+            languageId: 'llvm_p4',
+            compilerLanguage: 'p4',
+        } as ToolInfo,
+        env,
+    );
+}
+
+beforeEach(async () => {
+    tempDir = await fs.mkdtemp(path.join(os.tmpdir(), 'ce-p4-pipeline-'));
+    maxOutputSize = 1024;
+});
+
+afterEach(async () => {
+    await fs.rm(tempDir, {recursive: true, force: true});
+});
+
+describe('P4 pipeline tool', () => {
+    it('runs fixed and web arguments before its managed output and parent input', async () => {
+        const input = path.join(tempDir, 'input.ll');
+        await fs.writeFile(input, 'input');
+        const tool = makeTool('p4pipe-opt', ['-S']);
+
+        const result = await tool.runChainedTool(compilationInfo, input, ['-passes=instcombine']);
+
+        expect(result.outputFilename).toMatch(/\.opt\.ll$/);
+        expect(tool.calls[0]).toMatchObject({
+            exe: '/toolchain/bin/p4pipe-opt',
+            args: ['-S', '-passes=instcombine', '-o', result.outputFilename, input],
+            options: {customCwd: tempDir, env: {PIPELINE_TEST: '1'}, ldPath: ['/toolchain/lib']},
+        });
+        expect(result.result.stdout.map(line => line.text).join('\n')).toBe('generated output');
+    });
+
+    it('rejects attempts to override its managed output file', async () => {
+        const input = path.join(tempDir, 'input.mlir');
+        const tool = makeTool('p4pipe-mlir-opt');
+
+        const shortOption = await tool.runChainedTool(compilationInfo, input, ['-o', 'other.mlir']);
+        const longOption = await tool.runChainedTool(compilationInfo, input, ['--output=other.mlir']);
+
+        expect(shortOption.result.stderr[0].text).toContain('cannot be overridden');
+        expect(longOption.result.stderr[0].text).toContain('cannot be overridden');
+        expect(tool.calls).toHaveLength(0);
+    });
+
+    it('requires an explicit MIR stopping point', async () => {
+        const input = path.join(tempDir, 'input.ll');
+        const tool = makeTool('p4pipe-mir');
+
+        const missing = await tool.runChainedTool(compilationInfo, input, []);
+        const present = await tool.runChainedTool(compilationInfo, input, ['-stop-after=finalize-isel']);
+
+        expect(missing.result.stderr[0].text).toContain('requires -stop-before=... or -stop-after=...');
+        expect(present.outputFilename).toMatch(/\.mir$/);
+        expect(tool.calls).toHaveLength(1);
+    });
+
+    it('does not expose an output file after execution failure or missing output', async () => {
+        const input = path.join(tempDir, 'input.ll');
+        const failedTool = makeTool('p4pipe-opt');
+        failedTool.code = 1;
+        const missingTool = makeTool('p4pipe-opt');
+        missingTool.produceOutput = false;
+
+        const failed = await failedTool.runChainedTool(compilationInfo, input);
+        const missing = await missingTool.runChainedTool(compilationInfo, input);
+
+        expect(failed.outputFilename).toBeUndefined();
+        expect(failed.result.stderr.map(line => line.text).join('\n')).toContain('tool stderr');
+        expect(missing.outputFilename).toBeUndefined();
+        expect(missing.result.stderr[0].text).toContain('did not produce');
+    });
+
+    it('truncates only panel output and keeps the complete file for the child stage', async () => {
+        const input = path.join(tempDir, 'input.ll');
+        const tool = makeTool('p4pipe-opt');
+        tool.output = '123456789';
+        maxOutputSize = 5;
+
+        const result = await tool.runChainedTool(compilationInfo, input);
+
+        expect(result.result.stdout.map(line => line.text).join('\n')).toContain('12345');
+        expect(result.result.stdout.map(line => line.text).join('\n')).toContain('Output truncated');
+        expect(await fs.readFile(result.outputFilename!, 'utf8')).toBe('123456789');
+    });
+});
