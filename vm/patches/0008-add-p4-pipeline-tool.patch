+import fs from 'node:fs/promises';
+import path from 'node:path';
+
+import {CompilationInfo, ExecutionOptions} from '../../types/compilation/compilation.interfaces.js';
+import {UnprocessedExecResult} from '../../types/execution/execution.interfaces.js';
+import {OptionsHandlerLibrary} from '../options-handler.js';
+import {ChainedToolResult, IChainedTool} from './base-tool.interface.js';
+import {BaseTool} from './base-tool.js';
+
+const outputExtensions: Record<string, string> = {
+    'p4pipe-mlir-opt': '.llvm.mlir',
+    'p4pipe-mlir-translate': '.ll',
+    'p4pipe-opt': '.opt.ll',
+    'p4pipe-mir': '.mir',
+    'p4pipe-llc': '.s',
+};
+
+export class P4PipelineTool extends BaseTool implements IChainedTool {
+    static get key() {
+        return 'p4-pipeline-tool';
+    }
+
+    private getOutputFilename(inputFilepath: string): string | undefined {
+        const extension = outputExtensions[this.id];
+        if (!extension) return undefined;
+        return path.join(path.dirname(inputFilepath), this.getUniqueFilePrefix() + extension);
+    }
+
+    private validateUserArgs(args: string[]): string | undefined {
+        if (
+            args.some(arg => arg === '-o' || arg.startsWith('-o=') || arg === '--output' || arg.startsWith('--output='))
+        ) {
+            return 'The output option is managed by Compiler Explorer and cannot be overridden';
+        }
+        if (this.id === 'p4pipe-mir' && !args.some(arg => /^--?stop-(before|after)(=|$)/.test(arg))) {
+            return 'MIR generation requires -stop-before=... or -stop-after=...';
+        }
+        return undefined;
+    }
+
+    private getExecOptions(compilationInfo: CompilationInfo, inputFilepath: string): ExecutionOptions {
+        const baseOptions = compilationInfo.execOptions || this.getDefaultExecOptions();
+        return {
+            ...baseOptions,
+            env: baseOptions.env ? {...baseOptions.env} : undefined,
+            ldPath: compilationInfo.preparedLdPaths
+                ? [...compilationInfo.preparedLdPaths]
+                : baseOptions.ldPath
+                  ? [...baseOptions.ldPath]
+                  : undefined,
+            customCwd: path.dirname(inputFilepath),
+            input: undefined,
+        };
+    }
+
+    private async readOutput(outputFilename: string): Promise<{contents: string; truncated: boolean}> {
+        const maxSize = Math.max(0, Number(this.env.ceProps('max-asm-size', 64 * 1024 * 1024)));
+        const handle = await fs.open(outputFilename, 'r');
+        try {
+            const stat = await handle.stat();
+            const readSize = Math.min(stat.size, maxSize);
+            const buffer = Buffer.alloc(readSize);
+            if (readSize > 0) await handle.read(buffer, 0, readSize, 0);
+            return {contents: buffer.toString('utf8'), truncated: stat.size > maxSize};
+        } finally {
+            await handle.close();
+        }
+    }
+
+    private convertFailure(result: UnprocessedExecResult, inputFilepath: string) {
+        const converted = this.convertResult(result, inputFilepath, path.dirname(this.tool.exe));
+        return {result: converted};
+    }
+
+    async runChainedTool(
+        compilationInfo: CompilationInfo,
+        inputFilepath: string,
+        args: string[] = [],
+        _stdin?: string,
+        _supportedLibraries?: Record<string, OptionsHandlerLibrary>,
+    ): Promise<ChainedToolResult> {
+        const outputFilename = this.getOutputFilename(inputFilepath);
+        if (!outputFilename) return {result: this.createErrorResponse(`Unknown P4 pipeline stage: ${this.id}`)};
+
+        const validationError = this.validateUserArgs(args);
+        if (validationError) return {result: this.createErrorResponse(validationError)};
+
+        const toolArgs = [...this.tool.options, ...args, '-o', outputFilename, inputFilepath];
+        let execResult: UnprocessedExecResult;
+        try {
+            execResult = await this.exec(
+                this.getToolExe(compilationInfo),
+                toolArgs,
+                this.getExecOptions(compilationInfo, inputFilepath),
+            );
+        } catch {
+            return {result: this.createErrorResponse('Error while running P4 pipeline tool')};
+        }
+
+        if (execResult.code !== 0) return this.convertFailure(execResult, inputFilepath);
+
+        let output: {contents: string; truncated: boolean};
+        try {
+            output = await this.readOutput(outputFilename);
+        } catch {
+            return {result: this.createErrorResponse('P4 pipeline tool did not produce its expected output file')};
+        }
+
+        if (output.truncated) output.contents += '\n<Output truncated; the complete file is used by the next tool>';
+        const transformedInput = execResult.filenameTransform(inputFilepath);
+        const diagnostics = [execResult.stderr, execResult.stdout].filter(Boolean).join('\n');
+        return {
+            result: {
+                id: this.id,
+                name: this.tool.name,
+                code: 0,
+                languageId: this.tool.languageId,
+                stdout: this.parseOutput(output.contents),
+                stderr: this.parseOutput(diagnostics, transformedInput, path.dirname(this.tool.exe)),
+            },
+            outputFilename,
+        };
+    }
+}
