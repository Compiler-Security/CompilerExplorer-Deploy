new file mode 100644
index 0000000..612f6b9
--- /dev/null
+++ b/examples/p4/default.p4
@@ -0,0 +1,30 @@
+#include <core.p4>
+
+header ethernet_t {
+    bit<48> dst_addr;
+    bit<48> src_addr;
+    bit<16> ether_type;
+}
+
+struct headers_t {
+    ethernet_t ethernet;
+}
+
+control ingress(inout headers_t hdr) {
+    action drop() {
+        hdr.ethernet.setInvalid();
+    }
+
+    table forwarding {
+        key = {
+            hdr.ethernet.dst_addr: exact;
+        }
+        actions = {
+            drop;
+        }
+    }
+
+    apply {
+        forwarding.apply();
+    }
+}
