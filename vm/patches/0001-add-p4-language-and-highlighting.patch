diff --git a/static/modes/p4-mode.ts b/static/modes/p4-mode.ts
new file mode 100644
index 0000000..442d8ff
--- /dev/null
+++ b/static/modes/p4-mode.ts
@@ -0,0 +1,158 @@
+// Copyright (c) 2026, Compiler Explorer Authors
+// All rights reserved.
+
+import * as monaco from 'monaco-editor';
+
+export function definition(): monaco.languages.IMonarchLanguage {
+    return {
+        keywords: [
+            'abstract',
+            'action',
+            'apply',
+            'const',
+            'control',
+            'default',
+            'else',
+            'enum',
+            'exit',
+            'extern',
+            'false',
+            'header',
+            'header_union',
+            'if',
+            'in',
+            'inout',
+            'key',
+            'list',
+            'match_kind',
+            'out',
+            'package',
+            'parser',
+            'priority',
+            'return',
+            'select',
+            'state',
+            'struct',
+            'switch',
+            'table',
+            'this',
+            'transition',
+            'true',
+            'tuple',
+            'type',
+            'typedef',
+            'verify',
+        ],
+
+        types: ['bit', 'bool', 'error', 'int', 'string', 'varbit', 'void'],
+        builtins: ['packet_in', 'packet_out'],
+
+        operators: [
+            '=',
+            '>',
+            '<',
+            '!',
+            '~',
+            '?',
+            ':',
+            '==',
+            '<=',
+            '>=',
+            '!=',
+            '&&',
+            '||',
+            '++',
+            '--',
+            '+',
+            '-',
+            '*',
+            '/',
+            '&',
+            '|',
+            '^',
+            '%',
+            '<<',
+            '>>',
+        ],
+
+        symbols: /[=><!~?:&|+\-*\/^%]+/,
+        escapes: /\\(?:[abfnrtv\\"']|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})/,
+
+        tokenizer: {
+            root: [
+                [/^\s*#\s*[a-zA-Z_]\w*/, 'keyword.directive'],
+                {include: '@whitespace'},
+                [/@[a-zA-Z_]\w*/, 'annotation'],
+                [/[a-zA-Z_]\w*/, {
+                    cases: {
+                        '@types': 'type',
+                        '@builtins': 'type.identifier',
+                        '@keywords': 'keyword',
+                        '@default': 'identifier',
+                    },
+                }],
+                [/\d+[ws]0[xX][0-9a-fA-F_]+/, 'number.hex'],
+                [/\d+[ws]0[bB][01_]+/, 'number.binary'],
+                [/\d+[ws]\d[\d_]*/, 'number'],
+                [/0[xX][0-9a-fA-F_]+/, 'number.hex'],
+                [/0[bB][01_]+/, 'number.binary'],
+                [/\d[\d_]*/, 'number'],
+                [/"([^"\\]|\\.)*$/, 'string.invalid'],
+                [/"/, 'string', '@string'],
+                [/@symbols/, {cases: {'@operators': 'operator', '@default': ''}}],
+                [/[{}()[\]]/, '@brackets'],
+                [/[;,.]/, 'delimiter'],
+            ],
+
+            whitespace: [
+                [/[ \t\r\n]+/, 'white'],
+                [/\/\*/, 'comment', '@comment'],
+                [/\/\/.*$/, 'comment'],
+            ],
+
+            comment: [
+                [/[^/*]+/, 'comment'],
+                [/\/\*/, 'comment', '@push'],
+                ['\\*/', 'comment', '@pop'],
+                [/[/*]/, 'comment'],
+            ],
+
+            string: [
+                [/[^\\"]+/, 'string'],
+                [/@escapes/, 'string.escape'],
+                [/\\./, 'string.escape.invalid'],
+                [/"/, 'string', '@pop'],
+            ],
+        },
+    };
+}
+
+const config: monaco.languages.LanguageConfiguration = {
+    comments: {
+        lineComment: '//',
+        blockComment: ['/*', '*/'],
+    },
+    brackets: [
+        ['{', '}'],
+        ['[', ']'],
+        ['(', ')'],
+    ],
+    autoClosingPairs: [
+        {open: '{', close: '}'},
+        {open: '[', close: ']'},
+        {open: '(', close: ')'},
+        {open: '"', close: '"', notIn: ['string', 'comment']},
+        {open: "'", close: "'", notIn: ['string', 'comment']},
+    ],
+    surroundingPairs: [
+        {open: '{', close: '}'},
+        {open: '[', close: ']'},
+        {open: '(', close: ')'},
+        {open: '"', close: '"'},
+        {open: "'", close: "'"},
+    ],
+};
+
+monaco.languages.register({id: 'p4', extensions: ['.p4'], aliases: ['P4', 'p4-16']});
+monaco.languages.setMonarchTokensProvider('p4', definition());
+monaco.languages.setLanguageConfiguration('p4', config);
