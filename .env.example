# cp .env.example .env 后修改；.env 不进 Git。
# 宿主机工具链根（绝对路径），会只读挂到 /opt/compiler-explorer。
CE_COMPILERS_ROOT=/srv/ce/compilers

# CE release tag：https://github.com/compiler-explorer/compiler-explorer/tags
CE_REF=gh-18904

# VM（可选）
#VM_CPUS=8
#VM_MEM_MB=8192
# 修改磁盘大小后需用新的 FORCE_REPROVISION 令牌重建 overlay。
#VM_DISK_SIZE=40G
#QEMU_MEM_LIMIT=10g
#QEMU_CPUS=10
# 默认镜像自动读取官方 SHA256SUMS；自定义镜像应固定哈希或提供校验文件。
#VM_IMAGE_URL=https://mirror.example.com/ubuntu-26.04-server-cloudimg-amd64.img
#VM_IMAGE_SHA256=
#VM_IMAGE_SHA256_URL=https://mirror.example.com/SHA256SUMS
#NODE_VERSION=            # 空 = 最新 v22；修改后需重建 VM
#NODE_SHA256=             # 空 = 使用 Node 官方 SHASUMS256.txt

# SSH 管理通道（可选）：私钥供更新脚本使用，公钥注入 VM。
# ssh-keygen -t ed25519 -f ~/.ssh/ce_vm_key
#CE_VM_SSH_PORT=2223
#CE_VM_SSH_KEY=/root/.ssh/ce_vm_key
#CE_VM_SSH_PUBKEY=/root/.ssh/ce_vm_key.pub

# Kata 路径可改监听地址；QEMU 路径固定只监听回环。
#CE_BIND_ADDR=127.0.0.1

# 可选：固定核对过的工具链 SHA256；留空时更新脚本只打印实际哈希。
#LLVM_SHA256=
#GCC_SHA256=
#GCC_RISCV_SHA256=
